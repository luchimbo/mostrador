# Copiá este archivo como ".env" y completá los datos.
# NUNCA compartas el archivo .env: tiene las credenciales de Contabilium.

# "mock" = modo prueba (catálogo de ejemplo, facturas falsas)
# "real" = conectado a Contabilium (emite facturas REALES ante ARCA)
CONTABILIUM_MODE=mock

# "simulada" = usa el catálogo real pero las facturas son de prueba (no van a Contabilium ni a ARCA).
# Borrar esta línea (o dejarla vacía) para emitir facturas REALES.
FACTURACION=simulada

# IDs de Contabilium habilitados aunque no estén publicados en la tienda (separados por coma).
# Disponibles también para facturación real; no aparecen en la vidriera ni como sugerencias.
PRODUCTOS_PRUEBA_IDS=

# Contabilium -> Configuración -> API -> Credenciales
CONTABILIUM_CLIENT_ID=tu-email-de-api@ejemplo.com
CONTABILIUM_CLIENT_SECRET=tu-api-key

# ID del punto de venta electrónico a usar (correr "npm run probar-contabilium" para verlos)
CONTABILIUM_PUNTO_VENTA=

# ID del depósito activo del mostrador (GET /api/inventarios/getDepositos).
CONTABILIUM_INVENTARIO=

# Condiciones existentes. No se modifican desde esta app.
# MercadoPago: automática. Efectivo (incluye transferencias) y Otros: manual.
CONTABILIUM_MERCADOPAGO_CONDICION=MercadoPago
CONTABILIUM_EFECTIVO_CONDICION=Efectivo
CONTABILIUM_OTROS_CONDICION=Otro

# ID del cliente "Consumidor Final" genérico en Contabilium (para ventas sin DNI)
CONTABILIUM_ID_CLIENTE_CF=

# Puerto del servidor local
PORT=3000

# Tienda online de donde se toman las imágenes de los productos
TIENDANUBE_URL=https://www.pcmidi.com.ar
